# Copy to .env (which is git-ignored) and fill in your own keys. The SDK only reads a .env file when you
# ask it to:   kbsdk --env-file .env ...   |   kbsdk.load_env_file(".env")   |   env_file: .env  in a config
# Real environment variables always take precedence over values in this file.

GOOGLE_API_KEY=
GROQ_API_KEY=
